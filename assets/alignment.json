[
 {
  "text": "Kamu dah tulis maksud nama Allah dengan betul…",
  "sec": "HOOK",
  "syl": 15.6,
  "start": 1.09,
  "end": 3.33
 },
 {
  "text": "tapi markah tetap kena potong?",
  "sec": "HOOK",
  "syl": 10.0,
  "start": 3.85,
  "end": 5.63
 },
 {
  "text": "Haa, jangan risau.",
  "sec": "HOOK",
  "syl": 5.6,
  "start": 6.15,
  "end": 7.58
 },
 {
  "text": "Hari ni cikgu nak kongsi satu rahsia yang ramai calon SPM terlepas pandang!",
  "sec": "HOOK",
  "syl": 25.0,
  "start": 7.84,
  "end": 13.61
 },
 {
  "text": "Cuba tengok jawapan ni.",
  "sec": "MASALAH",
  "syl": 8.0,
  "start": 14.7,
  "end": 15.97
 },
 {
  "text": "Soalan tanya: apakah maksud al-Muntaqim?",
  "sec": "MASALAH",
  "syl": 13.6,
  "start": 16.41,
  "end": 19.89
 },
 {
  "text": "Murid jawab: Allah Maha Pembalas.",
  "sec": "MASALAH",
  "syl": 11.6,
  "start": 20.38,
  "end": 23.75
 },
 {
  "text": "Nampak macam betul, kan?",
  "sec": "MASALAH",
  "syl": 7.6,
  "start": 24.27,
  "end": 25.8
 },
 {
  "text": "Tapi sebenarnya…",
  "sec": "MASALAH",
  "syl": 6.6,
  "start": 26.23,
  "end": 27.34
 },
 {
  "text": "jawapan ni TAK LENGKAP.",
  "sec": "MASALAH",
  "syl": 7.0,
  "start": 27.78,
  "end": 29.24
 },
 {
  "text": "Ada perkataan penting yang tertinggal.",
  "sec": "MASALAH",
  "syl": 11.0,
  "start": 29.73,
  "end": 32.2
 },
 {
  "text": "Jadi, ingat baik-baik.",
  "sec": "KUNCI",
  "syl": 6.6,
  "start": 32.6,
  "end": 34.24
 },
 {
  "text": "Setiap kali kamu jawab soalan maksud nama Allah,",
  "sec": "KUNCI",
  "syl": 16.6,
  "start": 34.53,
  "end": 37.71
 },
 {
  "text": "mesti mulakan dengan lima perkataan ni:",
  "sec": "KUNCI",
  "syl": 13.6,
  "start": 37.94,
  "end": 40.81
 },
 {
  "text": "Nama…",
  "sec": "KUNCI",
  "syl": 2.6,
  "start": 41.47,
  "end": 41.94
 },
 {
  "text": "Allah SWT…",
  "sec": "KUNCI",
  "syl": 9.6,
  "start": 42.63,
  "end": 43.96
 },
 {
  "text": "yang…",
  "sec": "KUNCI",
  "syl": 1.6,
  "start": 44.58,
  "end": 45.11
 },
 {
  "text": "menunjukkan…",
  "sec": "KUNCI",
  "syl": 4.6,
  "start": 45.33,
  "end": 46.44
 },
 {
  "text": "bahawa.",
  "sec": "KUNCI",
  "syl": 3.0,
  "start": 46.88,
  "end": 47.3
 },
 {
  "text": "Nama Allah SWT yang menunjukkan bahawa.",
  "sec": "KUNCI",
  "syl": 19.0,
  "start": 47.68,
  "end": 52.11
 },
 {
  "text": "Ingat ya,",
  "sec": "KUNCI",
  "syl": 3.6,
  "start": 52.91,
  "end": 53.72
 },
 {
  "text": "lima perkataan ni bukan sekadar pembuka ayat.",
  "sec": "KUNCI",
  "syl": 16.0,
  "start": 54.19,
  "end": 58.01
 },
 {
  "text": "Ia SEBAHAGIAN daripada maksud.",
  "sec": "KUNCI",
  "syl": 11.0,
  "start": 58.33,
  "end": 61.03
 },
 {
  "text": "Kalau kamu tinggalkan,",
  "sec": "KUNCI",
  "syl": 7.6,
  "start": 61.73,
  "end": 63.02
 },
 {
  "text": "jawapan kamu dikira tak lengkap!",
  "sec": "KUNCI",
  "syl": 11.0,
  "start": 63.28,
  "end": 65.21
 },
 {
  "text": "Jom kita betulkan jawapan tadi.",
  "sec": "CONTOH",
  "syl": 11.0,
  "start": 65.82,
  "end": 68.22
 },
 {
  "text": "Maksud al-Muntaqim ialah:",
  "sec": "CONTOH",
  "syl": 8.6,
  "start": 68.52,
  "end": 70.91
 },
 {
  "text": "Nama Allah SWT yang menunjukkan bahawa Allah Maha Pembalas",
  "sec": "CONTOH",
  "syl": 26.0,
  "start": 71.16,
  "end": 78.3
 },
 {
  "text": "dengan menimpakan azab",
  "sec": "CONTOH",
  "syl": 8.0,
  "start": 78.47,
  "end": 80.17
 },
 {
  "text": "terhadap orang yang melampaui batas.",
  "sec": "CONTOH",
  "syl": 11.0,
  "start": 80.44,
  "end": 83.31
 },
 {
  "text": "Haa, tengok beza dia.",
  "sec": "CONTOH",
  "syl": 6.6,
  "start": 83.74,
  "end": 85.17
 },
 {
  "text": "Lengkap,",
  "sec": "CONTOH",
  "syl": 2.6,
  "start": 85.69,
  "end": 86.23
 },
 {
  "text": "tepat,",
  "sec": "CONTOH",
  "syl": 2.6,
  "start": 86.94,
  "end": 87.39
 },
 {
  "text": "dan ikut kehendak skema!",
  "sec": "CONTOH",
  "syl": 8.0,
  "start": 87.91,
  "end": 89.75
 },
 {
  "text": "Senang je nak ingat.",
  "sec": "FORMULA",
  "syl": 6.0,
  "start": 90.48,
  "end": 91.77
 },
 {
  "text": "Cikgu bagi formula.",
  "sec": "FORMULA",
  "syl": 7.0,
  "start": 92.26,
  "end": 93.73
 },
 {
  "text": "Mula dengan lima perkataan kunci,",
  "sec": "FORMULA",
  "syl": 11.6,
  "start": 94.11,
  "end": 97.47
 },
 {
  "text": "tambah sifat Allah,",
  "sec": "FORMULA",
  "syl": 6.6,
  "start": 97.82,
  "end": 99.56
 },
 {
  "text": "Allah Maha apa,",
  "sec": "FORMULA",
  "syl": 6.6,
  "start": 99.99,
  "end": 101.22
 },
 {
  "text": "kemudian sambung dengan huraiannya.",
  "sec": "FORMULA",
  "syl": 10.0,
  "start": 101.49,
  "end": 103.66
 },
 {
  "text": "Formula ni boleh guna untuk SEMUA nama Allah yang kamu belajar.",
  "sec": "FORMULA",
  "syl": 22.0,
  "start": 104.78,
  "end": 110.91
 },
 {
  "text": "Jadi lepas ni,",
  "sec": "CTA",
  "syl": 5.6,
  "start": 111.34,
  "end": 112.52
 },
 {
  "text": "jangan bagi markah terlepas",
  "sec": "CTA",
  "syl": 9.0,
  "start": 112.67,
  "end": 115.03
 },
 {
  "text": "hanya sebab lima perkataan.",
  "sec": "CTA",
  "syl": 9.0,
  "start": 115.74,
  "end": 117.64
 },
 {
  "text": "Save video ni,",
  "sec": "CTA",
  "syl": 5.6,
  "start": 117.85,
  "end": 120.12
 },
 {
  "text": "share dengan kawan-kawan SPM kamu,",
  "sec": "CTA",
  "syl": 13.6,
  "start": 120.29,
  "end": 124.36
 },
 {
  "text": "dan follow cikgu untuk lebih banyak tip Pendidikan Islam SPM.",
  "sec": "CTA",
  "syl": 21.0,
  "start": 124.79,
  "end": 130.06
 }
]